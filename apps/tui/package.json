{
  "name": "@open-bible/tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "open-bible-tui": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:bun": "bun --bun src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:bun": "bun --bun dist/index.js",
    "test": "vitest run",
    "test:tdd": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:binary": "bun build --compile src/index.ts --outfile dist/open-bible-tui",
    "install:local": "pnpm build && bun build --compile src/index.ts --outfile dist/open-bible-tui && install -Dm755 dist/open-bible-tui ~/.local/bin/open-bible-tui && echo \"installed to ~/.local/bin/open-bible-tui\""
  },
  "dependencies": {
    "@opentui/core": "0.5.8",
    "@opentui/react": "0.5.8",
    "better-sqlite3": "^12.11.1",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.2.0",
    "@types/node": "^26.0.0",
    "@types/react": "19.2.14",
    "tsx": "^4.19.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
