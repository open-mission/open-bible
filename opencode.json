{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "reui": {
      "type": "remote",
      "url": "https://mcp.reui.io",
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "dotcontext": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@dotcontext/mcp@latest"
      ],
      "enabled": true
    }
  }
}
